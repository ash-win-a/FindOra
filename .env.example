# Findora - Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Server Port
PORT=3000

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/findora
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/findora?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/findora

# Express Session Secret
SESSION_SECRET=findora_college_project_secret_key_replace_in_production

# Application Environment (development or production)
NODE_ENV=development
